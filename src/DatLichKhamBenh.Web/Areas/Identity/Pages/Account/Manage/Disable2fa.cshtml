@page
@model Disable2faModel
@{
    ViewData["Title"] = "Tắt xác thực hai lớp (2FA)";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>

<div class="alert alert-warning" role="alert">
    <p>
        <strong>Hành động này chỉ tắt 2FA.</strong>
    </p>
    <p>
        Tắt 2FA không thay đổi khóa được dùng trong ứng dụng xác thực. Nếu muốn đổi khóa
        dùng trong ứng dụng xác thực, bạn nên <a asp-page="./ResetAuthenticator">đặt lại khóa xác thực.</a>
    </p>
</div>

<div>
    <form method="post">
        <button class="btn btn-danger" type="submit">Tắt 2FA</button>
    </form>
</div>
