@{
    ViewData["Title"] = "Trang chủ";
}

<div class="hero mb-5">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <h1 class="display-6 fw-bold mb-3">Hệ thống đặt lịch khám bệnh online</h1>
            <p class="lead mb-4 opacity-90">Đặt lịch khám nhanh chóng, gửi thông tin bệnh trực tiếp cho bác sĩ và theo dõi lịch sử khám của bạn — mọi lúc, mọi nơi.</p>
            @if (User.Identity?.IsAuthenticated != true)
            {
                <a class="btn btn-primary btn-lg me-2" asp-area="Identity" asp-page="/Account/Register"><i class="bi bi-person-plus me-1"></i>Đăng ký ngay</a>
                <a class="btn btn-outline-secondary btn-lg" asp-controller="Doctors" asp-action="Index"><i class="bi bi-search me-1"></i>Xem danh sách bác sĩ</a>
            }
            else if (User.IsInRole("Patient"))
            {
                <a class="btn btn-primary btn-lg" asp-controller="Appointments" asp-action="Create"><i class="bi bi-calendar-plus me-1"></i>Đặt lịch khám ngay</a>
            }
            else
            {
                <a class="btn btn-primary btn-lg" asp-controller="Appointments" asp-action="Index"><i class="bi bi-calendar2-week me-1"></i>Xem lịch khám</a>
            }
        </div>
        <div class="col-lg-4 d-none d-lg-block text-center">
            <i class="bi bi-heart-pulse" style="font-size: 9rem; opacity: .25;"></i>
        </div>
    </div>
</div>

@{
    var isAuth = User.Identity?.IsAuthenticated == true;
    var isPatient = User.IsInRole("Patient");

    string BookUrl() => isPatient ? Url.Action("Create", "Appointments")! : isAuth ? Url.Action("Index", "Appointments")! : Url.Page("/Account/Register", new { area = "Identity" })!;
    string HistoryUrl() => isAuth ? Url.Action("Index", "Appointments")! : Url.Page("/Account/Login", new { area = "Identity" })!;
}

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <a href="@BookUrl()" class="text-decoration-none text-reset d-block h-100">
            <div class="card h-100 card-hover">
                <div class="card-body">
                    <div class="feature-icon"><i class="bi bi-calendar2-check"></i></div>
                    <h4>Đặt lịch trực tuyến</h4>
                    <p class="text-muted mb-0">Chọn bác sĩ, chọn giờ khám trống theo thời gian thực và đặt lịch chỉ trong vài bước.</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="@HistoryUrl()" class="text-decoration-none text-reset d-block h-100">
            <div class="card h-100 card-hover">
                <div class="card-body">
                    <div class="feature-icon"><i class="bi bi-clipboard2-pulse"></i></div>
                    <h4>Gửi thông tin bệnh</h4>
                    <p class="text-muted mb-0">Mô tả triệu chứng gửi trước cho bác sĩ để buổi khám hiệu quả hơn. Chọn một lịch khám để gửi.</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="@HistoryUrl()" class="text-decoration-none text-reset d-block h-100">
            <div class="card h-100 card-hover">
                <div class="card-body">
                    <div class="feature-icon"><i class="bi bi-journal-medical"></i></div>
                    <h4>Theo dõi lịch sử khám</h4>
                    <p class="text-muted mb-0">Xem lại toàn bộ lịch sử khám bệnh và chẩn đoán của bạn bất cứ lúc nào.</p>
                </div>
            </div>
        </a>
    </div>
</div>
