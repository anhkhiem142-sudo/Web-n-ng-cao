@model DatLichKhamBenh.Web.Models.ViewModels.RelativeFormViewModel
@{
    ViewData["Title"] = "Thêm người thân";
    var relationships = ViewBag.RelationshipOptions as string[] ?? Array.Empty<string>();
}

<h1 class="mb-4"><i class="bi bi-person-plus me-2 text-primary"></i>Thêm hồ sơ người thân</h1>
<p class="text-muted mb-4">Dùng hồ sơ này để đặt lịch khám thay cho người thân của bạn.</p>

<div class="card col-md-6"><div class="card-body">
<form asp-action="AddRelative" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Relationship" class="form-label"></label>
        <select asp-for="Relationship" class="form-select">
            <option value="">-- Chọn quan hệ --</option>
            @foreach (var r in relationships)
            {
                <option value="@r">@r</option>
            }
        </select>
        <span asp-validation-for="Relationship" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="FullName" class="form-label"></label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DateOfBirth" class="form-label"></label>
        <input asp-for="DateOfBirth" class="form-control flatpickr-date" type="text" autocomplete="off" data-max="@DateTime.Today.ToString("yyyy-MM-dd")" value="@Model.DateOfBirth.ToString("yyyy-MM-dd")" />
        <span asp-validation-for="DateOfBirth" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Gender" class="form-label"></label>
        <select asp-for="Gender" class="form-select" asp-items="Html.GetEnumSelectList<DatLichKhamBenh.Web.Models.Gender>()"></select>
    </div>
    <div class="mb-3">
        <label asp-for="Phone" class="form-label"></label>
        <input asp-for="Phone" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Address" class="form-label"></label>
        <input asp-for="Address" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Lưu</button>
    <a asp-action="Profile" class="btn btn-outline-secondary">Hủy</a>
</form>
</div></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
