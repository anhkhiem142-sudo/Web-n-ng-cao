@model IEnumerable<DatLichKhamBenh.Web.Models.Patient>
@{
    ViewData["Title"] = "Quản lý bệnh nhân";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Quản lý bệnh nhân</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Thêm bệnh nhân</a>
</div>

@if (TempData["Success"] is not null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form method="get" class="mb-3 d-flex gap-2">
    <input type="text" name="search" value="@ViewBag.Search" class="form-control w-auto" placeholder="Tìm theo tên hoặc SĐT" />
    <button type="submit" class="btn btn-outline-secondary">Tìm kiếm</button>
</form>

<div class="table-wrap">
<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Họ tên</th>
            <th>Ngày sinh</th>
            <th>Giới tính</th>
            <th>Điện thoại</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var patient in Model)
        {
            <tr>
                <td>@patient.FullName</td>
                <td>@patient.DateOfBirth.ToString("dd/MM/yyyy")</td>
                <td>@patient.Gender</td>
                <td>@patient.Phone</td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@patient.Id" class="btn btn-sm btn-outline-secondary">Chi tiết</a>
                    <a asp-action="Edit" asp-route-id="@patient.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                    <a asp-action="Delete" asp-route-id="@patient.Id" class="btn btn-sm btn-outline-danger">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
