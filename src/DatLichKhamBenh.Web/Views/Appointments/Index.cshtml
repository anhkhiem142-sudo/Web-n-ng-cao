@model IEnumerable<DatLichKhamBenh.Web.Models.Appointment>
@{
    ViewData["Title"] = "Lịch khám";
    var isAdmin = User.IsInRole("Admin");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@(User.IsInRole("Patient") ? "Lịch khám của tôi" : User.IsInRole("Doctor") ? "Lịch khám của tôi (Bác sĩ)" : "Tất cả lịch khám")</h1>
    @if (User.IsInRole("Patient"))
    {
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Đặt lịch khám</a>
    }
</div>

@if (TempData["Success"] is not null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <select name="status" class="form-select" onchange="this.form.submit()">
            <option value="">-- Tất cả trạng thái --</option>
            @foreach (var s in Enum.GetValues<DatLichKhamBenh.Web.Models.AppointmentStatus>())
            {
                <option value="@s" selected="@(ViewBag.Status?.Equals(s) == true)">@s</option>
            }
        </select>
    </div>
    @if (isAdmin)
    {
        <div class="col-auto">
            <select name="doctorId" class="form-select" asp-items="ViewBag.Doctors" onchange="this.form.submit()">
                <option value="">-- Tất cả bác sĩ --</option>
            </select>
        </div>
    }
    <div class="col-auto">
        <input type="date" name="date" class="form-control" value="@(ViewBag.Date as DateTime?)?.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
    </div>
</form>

<div class="table-wrap">
<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Ngày</th>
            <th>Giờ</th>
            @if (!User.IsInRole("Patient")) { <th>Bệnh nhân</th> }
            @if (!User.IsInRole("Doctor")) { <th>Bác sĩ</th> }
            <th>Phòng khám</th>
            <th>Trạng thái</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.AppointmentDate.ToString("dd/MM/yyyy")</td>
                <td>@a.TimeSlot</td>
                @if (!User.IsInRole("Patient")) { <td>@a.Patient?.FullName</td> }
                @if (!User.IsInRole("Doctor")) { <td>@a.Doctor?.FullName</td> }
                <td>@a.Room?.Name</td>
                <td><span class="badge bg-@(a.Status switch { DatLichKhamBenh.Web.Models.AppointmentStatus.Pending => "warning", DatLichKhamBenh.Web.Models.AppointmentStatus.Confirmed => "info", DatLichKhamBenh.Web.Models.AppointmentStatus.Completed => "success", _ => "secondary" })">@a.Status</span></td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@a.Id" class="btn btn-sm btn-outline-secondary">Chi tiết</a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
