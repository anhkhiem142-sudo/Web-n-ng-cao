@model DatLichKhamBenh.Web.Models.ViewModels.BookAppointmentViewModel
@{
    ViewData["Title"] = "Đặt lịch khám";
}

<h1 class="mb-1"><i class="bi bi-calendar-plus me-2 text-primary"></i>Đặt lịch khám</h1>
<p class="text-muted mb-4">Chọn bác sĩ, ngày và giờ khám phù hợp với bạn</p>

<div class="card col-md-7"><div class="card-body">
<form asp-action="Create" method="post" id="bookingForm">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="DoctorId" class="form-label"></label>
        <select asp-for="DoctorId" id="doctorSelect" class="form-select" asp-items="ViewBag.Doctors">
            <option value="">-- Chọn bác sĩ --</option>
        </select>
        <span asp-validation-for="DoctorId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="AppointmentDate" class="form-label"></label>
        <input asp-for="AppointmentDate" id="dateInput" class="form-control" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" value="@Model.AppointmentDate.ToString("yyyy-MM-dd")" />
        <span asp-validation-for="AppointmentDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Giờ khám</label>
        <div id="slotContainer" class="d-flex flex-wrap gap-2">
            <span class="text-muted">Vui lòng chọn bác sĩ và ngày khám để xem giờ trống.</span>
        </div>
        <input type="hidden" asp-for="TimeSlot" id="timeSlotInput" />
        <span asp-validation-for="TimeSlot" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Reason" class="form-label"></label>
        <textarea asp-for="Reason" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Reason" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle me-1"></i>Đặt lịch</button>
    <a asp-controller="Doctors" asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
</form>
</div></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const doctorSelect = document.getElementById('doctorSelect');
        const dateInput = document.getElementById('dateInput');
        const slotContainer = document.getElementById('slotContainer');
        const timeSlotInput = document.getElementById('timeSlotInput');

        async function loadSlots() {
            const doctorId = doctorSelect.value;
            const date = dateInput.value;
            timeSlotInput.value = '';

            if (!doctorId || !date) {
                slotContainer.innerHTML = '<span class="text-muted">Vui lòng chọn bác sĩ và ngày khám để xem giờ trống.</span>';
                return;
            }

            slotContainer.innerHTML = '<span class="text-muted">Đang tải giờ trống...</span>';
            const url = `@Url.Action("AvailableSlots", "Appointments")?doctorId=${doctorId}&date=${date}`;
            const response = await fetch(url);
            if (!response.ok) {
                slotContainer.innerHTML = '<span class="text-danger">Không thể tải giờ khám.</span>';
                return;
            }
            const slots = await response.json();
            slotContainer.innerHTML = '';
            slots.forEach(slot => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.textContent = slot.value;
                btn.className = 'btn btn-sm ' + (slot.available ? 'btn-outline-primary' : 'btn-outline-secondary disabled');
                if (!slot.available) {
                    btn.disabled = true;
                } else {
                    btn.addEventListener('click', () => {
                        document.querySelectorAll('#slotContainer button').forEach(b => b.classList.remove('active'));
                        btn.classList.add('active');
                        timeSlotInput.value = slot.value;
                    });
                }
                slotContainer.appendChild(btn);
            });
        }

        doctorSelect.addEventListener('change', loadSlots);
        dateInput.addEventListener('change', loadSlots);
        if (doctorSelect.value && dateInput.value) loadSlots();
    </script>
}
