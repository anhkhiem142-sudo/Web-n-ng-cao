@model DatLichKhamBenh.Web.Models.ViewModels.BookAppointmentViewModel
@{
    ViewData["Title"] = "Đặt lịch khám";
    var relationships = ViewBag.RelationshipOptions as string[] ?? Array.Empty<string>();
    var doctorsJson = System.Text.Json.JsonSerializer.Serialize(ViewBag.DoctorsData);
}

<h1 class="mb-1"><i class="bi bi-calendar-plus me-2 text-primary"></i>Đặt lịch khám</h1>
<p class="text-muted mb-4">Chọn bác sĩ hoặc chuyên khoa, người tới khám, ngày và giờ phù hợp với bạn</p>

<form asp-action="Create" method="post" id="bookingForm">
    @Html.AntiForgeryToken()
    <div class="row g-3">
        <!-- Cột 1: Thông tin đặt khám -->
        <div class="col-lg-3">
            <div class="card h-100"><div class="card-body">
                <h5 class="mb-3"><i class="bi bi-clipboard2-pulse me-1 text-primary"></i>Thông tin đặt khám</h5>
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <label class="form-label">Phương thức đặt khám</label>
                <div class="btn-group w-100 mb-3" role="group">
                    <input type="radio" class="btn-check" name="bookingMode" id="modeDoctor" checked>
                    <label class="btn btn-outline-primary" for="modeDoctor">Bác sĩ</label>
                    <input type="radio" class="btn-check" name="bookingMode" id="modeSpecialty">
                    <label class="btn btn-outline-primary" for="modeSpecialty">Chuyên khoa</label>
                </div>

                <div class="mb-3" id="specialtyGroup" hidden>
                    <label class="form-label">Chọn chuyên khoa</label>
                    <select id="specialtySelect" class="form-select">
                        <option value="">-- Tất cả chuyên khoa --</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="PatientId" class="form-label"></label>
                    <select asp-for="PatientId" id="patientSelect" class="form-select mb-2" asp-items="ViewBag.PatientProfiles">
                        <option value="">-- Chọn người tới khám --</option>
                    </select>
                    <button type="button" class="btn btn-outline-secondary btn-sm w-100" data-bs-toggle="modal" data-bs-target="#addRelativeModal">
                        <i class="bi bi-person-plus me-1"></i>Thêm người thân
                    </button>
                    <span asp-validation-for="PatientId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="AppointmentDate" class="form-label"></label>
                    <input asp-for="AppointmentDate" id="dateInput" class="form-control flatpickr-date" type="text" autocomplete="off" data-min="@DateTime.Today.ToString("yyyy-MM-dd")" value="@Model.AppointmentDate.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="AppointmentDate" class="text-danger"></span>
                </div>

                <div class="mb-1">
                    <label class="form-label">Sử dụng Bảo hiểm y tế <span class="text-danger">*</span></label>
                    <div class="btn-group w-100" role="group">
                        <input type="radio" class="btn-check" name="HasInsurance" id="insuranceYes" value="true">
                        <label class="btn btn-outline-primary" for="insuranceYes">Có</label>
                        <input type="radio" class="btn-check" name="HasInsurance" id="insuranceNo" value="false">
                        <label class="btn btn-outline-primary" for="insuranceNo">Không</label>
                    </div>
                    <span asp-validation-for="HasInsurance" class="text-danger d-block mt-1"></span>
                </div>

                <input type="hidden" asp-for="DoctorId" id="doctorIdInput" />
                <span asp-validation-for="DoctorId" class="text-danger"></span>
            </div></div>
        </div>

        <!-- Cột 2: Danh sách bác sĩ -->
        <div class="col-lg-5">
            <div class="card h-100"><div class="card-body">
                <h5 class="mb-3"><i class="bi bi-person-badge me-1 text-primary"></i>Bác sĩ</h5>
                <div class="d-flex gap-2 mb-3">
                    <input type="text" id="doctorSearch" class="form-control" placeholder="Tìm kiếm theo tên bác sĩ...">
                </div>
                <div class="mb-2">
                    <span class="badge text-bg-primary"><i class="bi bi-people me-1"></i>Tìm thấy <span id="doctorCount">0</span> bác sĩ phù hợp</span>
                </div>
                <div id="doctorList" class="doctor-list-scroll"></div>
            </div></div>
        </div>

        <!-- Cột 3: Tóm tắt lịch khám -->
        <div class="col-lg-4">
            <div class="card h-100"><div class="card-body">
                <h5 class="mb-3"><i class="bi bi-clipboard-check me-1 text-primary"></i>Tóm tắt lịch khám</h5>

                <div id="summaryEmpty" class="text-center text-muted py-5">
                    <i class="bi bi-calendar2-x" style="font-size: 2.5rem; opacity: .4;"></i>
                    <p class="mt-3 mb-0">Vui lòng chọn bác sĩ và giờ khám để xem chi tiết.</p>
                </div>

                <div id="summaryBox" class="d-none">
                    <dl class="row mb-3">
                        <dt class="col-5">Người tới khám</dt><dd class="col-7" id="sumPatient">-</dd>
                        <dt class="col-5">Bác sĩ</dt><dd class="col-7" id="sumDoctor">-</dd>
                        <dt class="col-5">Chuyên khoa</dt><dd class="col-7" id="sumSpecialty">-</dd>
                        <dt class="col-5">Phòng khám</dt><dd class="col-7" id="sumRoom">-</dd>
                        <dt class="col-5">Ngày khám</dt><dd class="col-7" id="sumDate">-</dd>
                        <dt class="col-5">Giờ khám</dt><dd class="col-7" id="sumTime">-</dd>
                        <dt class="col-5">Bảo hiểm y tế</dt><dd class="col-7" id="sumInsurance">-</dd>
                    </dl>

                    <label class="form-label">Giờ khám</label>
                    <div id="slotContainer" class="mb-3">
                        <span class="text-muted small">Vui lòng chọn ngày khám để xem giờ trống.</span>
                    </div>
                    <input type="hidden" asp-for="TimeSlot" id="timeSlotInput" />
                    <span asp-validation-for="TimeSlot" class="text-danger"></span>

                    <div class="mb-3">
                        <label asp-for="Reason" class="form-label"></label>
                        <textarea asp-for="Reason" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Reason" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-check2-circle me-1"></i>Đặt lịch</button>
                </div>
            </div></div>
        </div>
    </div>
</form>

<!-- Modal: add a relative profile without leaving the booking form -->
<div class="modal fade" id="addRelativeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-person-plus me-1"></i>Thêm người thân</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="relativeFormError" class="alert alert-danger d-none"></div>
                <div class="mb-3">
                    <label class="form-label">Quan hệ với bạn</label>
                    <select id="relRelationship" class="form-select">
                        <option value="">-- Chọn quan hệ --</option>
                        @foreach (var r in relationships)
                        {
                            <option value="@r">@r</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Họ tên</label>
                    <input id="relFullName" class="form-control" />
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Ngày sinh</label>
                        <input id="relDob" type="text" class="form-control flatpickr-date" autocomplete="off" data-max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Giới tính</label>
                        <select id="relGender" class="form-select">
                            <option value="0">Nam</option>
                            <option value="1">Nữ</option>
                            <option value="2">Khác</option>
                        </select>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Số điện thoại</label>
                    <input id="relPhone" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Địa chỉ</label>
                    <input id="relAddress" class="form-control" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" id="saveRelativeBtn" class="btn btn-primary">Lưu và chọn</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const doctors = @Html.Raw(doctorsJson);

        const modeDoctor = document.getElementById('modeDoctor');
        const modeSpecialty = document.getElementById('modeSpecialty');
        const specialtyGroup = document.getElementById('specialtyGroup');
        const specialtySelect = document.getElementById('specialtySelect');
        const doctorSearch = document.getElementById('doctorSearch');
        const doctorList = document.getElementById('doctorList');
        const doctorCount = document.getElementById('doctorCount');
        const doctorIdInput = document.getElementById('doctorIdInput');
        const patientSelect = document.getElementById('patientSelect');
        const dateInput = document.getElementById('dateInput');
        const slotContainer = document.getElementById('slotContainer');
        const timeSlotInput = document.getElementById('timeSlotInput');
        const insuranceYes = document.getElementById('insuranceYes');
        const insuranceNo = document.getElementById('insuranceNo');

        document.querySelectorAll('input[name="HasInsurance"]').forEach(el => {
            el.addEventListener('change', updateSummary);
        });

        function populateSpecialties() {
            const specialties = [...new Set(doctors.map(d => d.specialty))].sort();
            specialties.forEach(s => {
                const opt = document.createElement('option');
                opt.value = s; opt.textContent = s;
                specialtySelect.appendChild(opt);
            });
        }

        function initials(name) {
            const letters = name.split(' ').filter(w => w.length > 0).map(w => w[0]).join('').toUpperCase();
            return letters.length > 2 ? letters.slice(-2) : letters;
        }

        function renderDoctorList() {
            const search = doctorSearch.value.trim().toLowerCase();
            const specialty = modeSpecialty.checked ? specialtySelect.value : '';
            const filtered = doctors.filter(d =>
                (!search || d.fullName.toLowerCase().includes(search)) &&
                (!specialty || d.specialty === specialty));

            doctorCount.textContent = filtered.length;
            doctorList.innerHTML = '';

            if (filtered.length === 0) {
                doctorList.innerHTML = '<p class="text-muted text-center py-4">Không tìm thấy bác sĩ phù hợp.</p>';
                return;
            }

            filtered.forEach(d => {
                const selected = String(d.id) === String(doctorIdInput.value);
                const card = document.createElement('div');
                card.className = 'card doctor-list-card mb-2' + (selected ? ' selected' : '');
                card.innerHTML = `
                    <div class="card-body d-flex align-items-center justify-content-between py-2">
                        <div class="d-flex align-items-center gap-3">
                            <div class="doctor-avatar">${initials(d.fullName)}</div>
                            <div>
                                <div class="fw-bold">${d.fullName}</div>
                                <div class="text-primary small">Chuyên khoa: ${d.specialty}</div>
                                <div class="text-muted small">${d.room || ''}</div>
                            </div>
                        </div>
                        <button type="button" class="btn btn-sm ${selected ? 'btn-success' : 'btn-primary'}">${selected ? 'Đã chọn' : 'Chọn'}</button>
                    </div>`;
                card.querySelector('button').addEventListener('click', () => selectDoctor(d.id));
                doctorList.appendChild(card);
            });
        }

        function selectDoctor(id) {
            doctorIdInput.value = id;
            renderDoctorList();
            loadSlots();
            updateSummary();
        }

        modeDoctor.addEventListener('change', () => { specialtyGroup.hidden = true; renderDoctorList(); });
        modeSpecialty.addEventListener('change', () => { specialtyGroup.hidden = false; renderDoctorList(); });
        specialtySelect.addEventListener('change', renderDoctorList);
        doctorSearch.addEventListener('input', renderDoctorList);

        async function loadSlots() {
            const doctorId = doctorIdInput.value;
            const date = dateInput.value;
            timeSlotInput.value = '';

            if (!doctorId || !date) {
                slotContainer.innerHTML = '<span class="text-muted small">Vui lòng chọn bác sĩ và ngày khám để xem giờ trống.</span>';
                updateSummary();
                return;
            }

            slotContainer.innerHTML = '<span class="text-muted small">Đang tải giờ trống...</span>';
            const url = `@Url.Action("AvailableSlots", "Appointments")?doctorId=${doctorId}&date=${date}`;
            const response = await fetch(url);
            if (!response.ok) {
                slotContainer.innerHTML = '<span class="text-danger small">Không thể tải giờ khám.</span>';
                return;
            }
            const slots = await response.json();
            slotContainer.innerHTML = '';

            function makeSlotButton(slot) {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.textContent = slot.value;
                btn.className = 'btn btn-sm ' + (slot.available ? 'btn-outline-primary' : 'btn-outline-secondary disabled');
                if (!slot.available) {
                    btn.disabled = true;
                } else {
                    btn.addEventListener('click', () => {
                        document.querySelectorAll('#slotContainer button').forEach(b => b.classList.remove('active'));
                        btn.classList.add('active');
                        timeSlotInput.value = slot.value;
                        updateSummary();
                    });
                }
                return btn;
            }

            function renderGroup(label, icon, list) {
                if (list.length === 0) return;
                const wrap = document.createElement('div');
                wrap.className = 'slot-group mb-2';
                wrap.innerHTML = `<div class="slot-group-label"><i class="bi ${icon} me-1"></i>${label}</div>`;
                const row = document.createElement('div');
                row.className = 'd-flex flex-wrap gap-2 mb-2';
                list.forEach(slot => row.appendChild(makeSlotButton(slot)));
                wrap.appendChild(row);
                slotContainer.appendChild(wrap);
            }

            renderGroup('Sáng', 'bi-sun-fill', slots.filter(s => s.value < '12:00'));
            renderGroup('Chiều', 'bi-cloud-sun-fill', slots.filter(s => s.value >= '12:00'));

            updateSummary();
        }

        function updateSummary() {
            const doctor = doctors.find(d => String(d.id) === String(doctorIdInput.value));
            const patientLabel = patientSelect.options[patientSelect.selectedIndex]?.text;
            const hasCore = doctor && patientLabel && patientSelect.value;

            document.getElementById('summaryEmpty').classList.toggle('d-none', !!hasCore);
            document.getElementById('summaryBox').classList.toggle('d-none', !hasCore);
            if (!hasCore) return;

            document.getElementById('sumPatient').textContent = patientLabel;
            document.getElementById('sumDoctor').textContent = doctor.fullName;
            document.getElementById('sumSpecialty').textContent = doctor.specialty;
            document.getElementById('sumRoom').textContent = doctor.room || '-';
            document.getElementById('sumDate').textContent = dateInput.value || '-';
            document.getElementById('sumTime').textContent = timeSlotInput.value || '-';
            document.getElementById('sumInsurance').textContent = insuranceYes.checked ? 'Có' : (insuranceNo.checked ? 'Không' : '-');
        }

        dateInput.addEventListener('change', loadSlots);
        patientSelect.addEventListener('change', updateSummary);

        populateSpecialties();
        renderDoctorList();

        const preselectedDoctorId = '@Model.DoctorId';
        if (preselectedDoctorId && preselectedDoctorId !== '0') {
            doctorIdInput.value = preselectedDoctorId;
            renderDoctorList();
        }
        const preselectedPatientId = '@Model.PatientId';
        if (preselectedPatientId && preselectedPatientId !== '0') {
            patientSelect.value = preselectedPatientId;
        }
        if (doctorIdInput.value && dateInput.value) loadSlots();
        updateSummary();

        // "+ Thêm người thân" modal: saves via fetch, then selects the new profile — no page reload needed.
        document.getElementById('saveRelativeBtn').addEventListener('click', async () => {
            const errorBox = document.getElementById('relativeFormError');
            errorBox.classList.add('d-none');

            const formData = new FormData();
            formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);
            formData.append('Relationship', document.getElementById('relRelationship').value);
            formData.append('FullName', document.getElementById('relFullName').value);
            formData.append('DateOfBirth', document.getElementById('relDob').value);
            formData.append('Gender', document.getElementById('relGender').value);
            formData.append('Phone', document.getElementById('relPhone').value);
            formData.append('Address', document.getElementById('relAddress').value);

            const response = await fetch('@Url.Action("AddRelativeAjax", "Patients")', {
                method: 'POST',
                body: formData
            });

            if (!response.ok) {
                const data = await response.json().catch(() => null);
                const messages = data?.errors ? Object.values(data.errors).flat() : ['Không thể lưu thông tin. Vui lòng kiểm tra lại.'];
                errorBox.textContent = messages.join(' ');
                errorBox.classList.remove('d-none');
                return;
            }

            const result = await response.json();
            const opt = document.createElement('option');
            opt.value = result.id;
            opt.textContent = result.label;
            patientSelect.appendChild(opt);
            patientSelect.value = result.id;
            updateSummary();

            bootstrap.Modal.getInstance(document.getElementById('addRelativeModal')).hide();
        });
    </script>
}
