@model IEnumerable<DatLichKhamBenh.Web.Models.Doctor>
@{
    ViewData["Title"] = "Danh sách bác sĩ";
    var specialties = ViewBag.Specialties as List<string> ?? new List<string>();
    var selected = ViewBag.SelectedSpecialty as string;
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <div>
        <h1 class="mb-1">Danh sách bác sĩ</h1>
        <p class="text-muted mb-0">Chọn bác sĩ phù hợp để đặt lịch khám</p>
    </div>
    <div>
        <label class="form-label mb-1">Lọc theo chuyên khoa</label>
        <select id="specialtyFilter" class="form-select">
            <option value="">Tất cả chuyên khoa</option>
            @foreach (var s in specialties)
            {
                <option value="@s" selected="@(s == selected)">@s</option>
            }
        </select>
    </div>
</div>

<div class="row g-3" id="doctorList">
    @await Html.PartialAsync("_DoctorCards", Model)
</div>

@section Scripts {
    <script>
        document.getElementById('specialtyFilter').addEventListener('change', async function () {
            const specialty = this.value;
            const url = '@Url.Action("Filter", "Doctors")' + '?specialty=' + encodeURIComponent(specialty);
            const response = await fetch(url);
            if (response.ok) {
                document.getElementById('doctorList').innerHTML = await response.text();
            }
        });
    </script>
}
