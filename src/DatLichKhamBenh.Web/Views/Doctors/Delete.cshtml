@model DatLichKhamBenh.Web.Models.Doctor
@{
    ViewData["Title"] = "Xóa bác sĩ";
}

<h1>Xóa bác sĩ</h1>
<div class="alert alert-warning">Bạn có chắc muốn xóa bác sĩ <strong>@Model.FullName</strong>?</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
    <a asp-action="ManageIndex" class="btn btn-secondary">Hủy</a>
</form>
