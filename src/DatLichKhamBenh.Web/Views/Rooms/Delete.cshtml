@model DatLichKhamBenh.Web.Models.Room
@{
    ViewData["Title"] = "Xóa phòng khám";
}

<h1>Xóa phòng khám</h1>
<div class="alert alert-warning">Bạn có chắc muốn xóa phòng khám <strong>@Model.Name</strong>?</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>
